# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Used to add/deactivate users from the admin screen and to send
# notification emails. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in email links), no trailing slash.
NEXT_PUBLIC_APP_URL=https://your-helpdesk.vercel.app

# Email notifications via Resend (optional; in-app notifications work without it).
RESEND_API_KEY=
EMAIL_FROM=IT Helpdesk <helpdesk@yourcompany.com>

# Optional; defaults to Asia/Kolkata.
NEXT_PUBLIC_TIMEZONE=Asia/Kolkata
